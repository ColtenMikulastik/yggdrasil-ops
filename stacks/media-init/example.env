# numeric ids the media apps run as; no host user is required, pick unused numbers
MEDIA_UID=1500
# must be 33 (www-data): nextcloud's apache workers drop extra groups, so group_add is not enough
MEDIA_GID=33
# shared library root (movies, tv, music, audiobooks, podcasts, books are created inside)
MEDIA_PATH=/home/luca/media
# state for jellyfin + audiobookshelf (config, cache, metadata) lives here
APPDATA_PATH=/home/luca/appdata
