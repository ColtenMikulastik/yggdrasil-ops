DATA_PATH=/home/luca/claude-code/
CLAUDE_SESSION_NAME=yggdrasil
# acceptEdits | default | plan | bypassPermissions (ok here, the container is the sandbox)
CLAUDE_PERMISSION_MODE=acceptEdits

# --- all optional: leave empty to run as a general agent with an empty /workspace ---
GIT_USER_NAME=Claude Code
GIT_USER_EMAIL=
# auto-clone into /workspace on first start (SSH URL, needs the deploy key)
GIT_REPO=
GIT_BRANCH=
# base64 of a repo-scoped deploy key: base64 < deploy_key | tr -d '\n'
DEPLOY_KEY_B64=
